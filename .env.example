# Server-only keys. Copy to .env.local and fill in. Never prefix with NEXT_PUBLIC_.
RAPIDAPI_KEY=
OPENWEATHER_API_KEY=
UNSPLASH_ACCESS_KEY=
# Set to true to serve demo fixtures (no API calls, no quota used; pages show a "Demo data" banner)
USE_MOCK_DATA=false
# Set to true to fetch real Unsplash photos even in mock mode (uses Unsplash quota)
USE_REAL_PHOTOS=false
